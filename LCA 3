#include<stdio.h>
int main()
{
int a;
int b;
char operator;

printf("Enter the operator");
scanf("%c", &operator);

printf("Enter the Numbers");
scanf(" %d %d ", &a, &b);

switch (operator) {
case '+' :
   printf("%d", a + b);
   break;

case '-' :
   printf("%d", a + b);
   break;

case '*' :
   printf("%d", a + b);
   break;

case '/' :
   printf("%d", a + b);
   break;

default : printf("Operator Entered is Invalid");

}

return 0;

}
