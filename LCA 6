#include<stdio.h>
 
int fact_loop (int n)
{
  int f = 1, i;
  for ( i = 1 ; i <= n ; i++)
  {
    f = f*i;
  }
  return f;
}

int fact_rec (int n)
{
    if(n<=1)
    return 1;
     
    return n*fact_rec(n-1);

}

int main ()
{
    int n ;
    printf("Enter the number : ");
    scanf("%d", &n);

    printf("Factorial without recursion is : %d \n", fact_loop(n));
    printf("Factorial with recursion is : %d \n", fact_rec(n));

    return 0;
}
